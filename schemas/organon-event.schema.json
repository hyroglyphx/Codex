{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miketatemath.org/schemas/organon-event.schema.json",
  "title": "OrganonEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "timestamp",
    "actor",
    "authority",
    "object_id",
    "object_type",
    "domain",
    "event_type",
    "operation",
    "input_state",
    "output_state",
    "confidence",
    "maturity",
    "return_path"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "epoch": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "enum": [
        "L0_SOURCE",
        "L1_USER",
        "L2_CANONICAL",
        "L3_VALIDATED",
        "L4_HYPOTHESIS"
      ]
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_type": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "observe",
        "propose",
        "transform",
        "test",
        "challenge",
        "corroborate",
        "promote",
        "repair",
        "quarantine",
        "supersede",
        "rollback",
        "build",
        "result"
      ]
    },
    "parent_events": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "representation": {
      "type": [
        "string",
        "object",
        "array",
        "null"
      ]
    },
    "input_state": {},
    "output_state": {},
    "preserved": {
      "type": "array",
      "items": {},
      "default": []
    },
    "altered": {
      "type": "array",
      "items": {},
      "default": []
    },
    "lost": {
      "type": "array",
      "items": {},
      "default": []
    },
    "introduced": {
      "type": "array",
      "items": {},
      "default": []
    },
    "evidence": {
      "type": "array",
      "items": {},
      "default": []
    },
    "counterevidence": {
      "type": "array",
      "items": {},
      "default": []
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "maturity": {
      "type": "string",
      "enum": [
        "OBSERVED",
        "CANDIDATE",
        "TESTED",
        "CORROBORATED",
        "CANONICAL",
        "FAILED",
        "CONTRADICTED",
        "SUPERSEDED",
        "OMEGA_UNRESOLVED"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "return_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}